  "scripts": {
    "postinstall": "npx update-browserslist-db@latest || true",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:prod": "vite build",
    "build:with-compression": "npm run build && ./scripts/precompress-assets.sh",
    "test": "vitest",
    "test:e2e": "node tests/run_frontend_tests.js",
    "test:frontend": "node tests/test_frontend.js",
    "test:validation": "node tests/validate_frontend.js",
    "test:mapview": "node tests/test_map_view_and_proptypes.js",
    "test:nodejs": "node tests/test_nodejs_upgrade.js",
    "test:comprehensive": "node tests/run_comprehensive_tests.js",
    "test:all": "npm run test:nodejs && npm run test:mapview && npm run test:validation",
    "lint": "eslint src --max-warnings 0",
    "lint:ci": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,md}\"",
    "lint:check": "node scripts/lint-check.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "nth-check": "^2.0.1",
    "svgo": "^3.0.2",
