# Development stage with testing capabilities
FROM node:22-alpine

WORKDIR /app

# System Chromium for Playwright e2e scripts (Alpine cannot use Playwright's bundled browsers)
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# E2E scripts run inside this container; reach the reverse proxy by service name
ENV TEST_BASE_URL=http://nginx
ENV TEST_BACKEND_URL=http://backend:8000

# Set npm configuration for better reliability
RUN npm config set registry https://registry.npmjs.org/
RUN npm config set fetch-retries 3
RUN npm config set fetch-retry-mintimeout 5000
RUN npm config set fetch-retry-maxtimeout 60000

# Copy package files
COPY package*.json ./

# Install ALL dependencies (including devDependencies for testing)
RUN npm ci --timeout=300000

# Copy source code
COPY . .

# Expose port for development server
EXPOSE 3000

# Start development server
CMD ["npm", "start"]
